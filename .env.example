# Copy to .env to change defaults. Every value is optional.
# PSAI_DATA_DIR=data                       # where the database and your files live (relative or absolute)
# PSAI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# PSAI_EMBEDDER=auto                       # auto | sentence-transformers | hash (offline fallback, used by tests)
# PSAI_OLLAMA_HOST=http://localhost:11434
# PSAI_OLLAMA_MODEL=llama3.2:3b
# PSAI_OFFLINE=0                           # 1 = never download models (use after the first run)
# PSAI_CHUNK_WORDS=160
# PSAI_CHUNK_OVERLAP=30
# PSAI_MAX_UPLOAD_MB=50
# PSAI_ALLOW_REMOTE_LLM=0                  # keep 0 to guarantee the LLM runs on this computer
